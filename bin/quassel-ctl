#!/usr/bin/env bash
# Quassel per Kommandozeile schalten: quassel-ctl [toggle|start|stop|panic]
set -u
cmd="${1:-toggle}"
profile="${QUASSEL_PROFILE:-}"
if [[ -n "$profile" && ! "$profile" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]]; then
    echo "invalid QUASSEL_PROFILE: expected lowercase letters, digits and hyphens (1-32 characters)" >&2
    exit 2
fi
if [[ -n "$profile" ]]; then
    daemon="quasseld@$profile.service"
    server="quassel-server@$profile.service"
    pill="quassel-pill@$profile.service"
else
    daemon="quasseld"
    server="quassel-server"
    pill="quassel-pill"
fi
running() { systemctl --user is-active --quiet "$daemon"; }
case "$cmd" in toggle) if running; then cmd=stop; else cmd=start; fi ;; esac
case "$cmd" in
    start)
        # Anzeige dieser Sitzung an systemd geben (nur gesetzte Werte), sonst
        # weiß quasseld unter Sway/Hyprland nicht, wohin er tippt.
        vars=""
        for v in WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE; do
            [ -n "${!v:-}" ] && vars="$vars $v"
        done
        [ -n "$vars" ] && systemctl --user import-environment $vars
        systemctl --user start "$daemon" "$server" "$pill" ;;
    stop)
        if [[ -n "$profile" ]]; then
            systemctl --user stop "$daemon" "$server"
        else
            systemctl --user stop "$daemon" "$server" quassel-ydotoold
        fi ;;
    panic) systemctl --user kill -s USR2 "$daemon" ;;
    *) echo "usage: quassel-ctl [toggle|start|stop|panic]" >&2; exit 2 ;;
esac
